# 服务器配置
HOST=127.0.0.1
PORT=8080
DEBUG=False
SECRET_KEY=your-secret-key-here

# 可选：开启简单鉴权（留空则不校验）
API_TOKEN=

# 可选：CORS 允许的来源（逗号分隔），例如：http://127.0.0.1:8080,http://localhost:8080
# 留空表示仅同源（更安全）
CORS_ORIGINS=

# CUDA配置
CUDA_AVAILABLE=true

# 可选：官方权重下载镜像前缀（弱网 / 内网自建镜像时使用）
# 默认走界面选择的下载源（自动 = 魔搭镜像优先，缺失回落 GitHub）
# 配置本变量后优先级最高，会覆盖界面选择；.pt 是 pickle 容器，别用不可信的第三方加速站
# 例：EIS_MODEL_MIRROR=https://mirror.example.com/
EIS_MODEL_MIRROR=

# 上传文件夹
UPLOAD_FOLDER=uploads
